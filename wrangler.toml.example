name = "telegram-mod-bot"
main = "src/index.ts"
compatibility_date = "2024-10-01"

# ---------------------------------------------------------------------------
# Configuration (non-secret values). Secrets stay in `.dev.vars` locally and
# in the Cloudflare dashboard / `wrangler secret put` in production.
# ---------------------------------------------------------------------------

# OpenAI-compatible endpoint, WITHOUT trailing slash. Examples:
#   https://api.openai.com/v1
#   https://openrouter.ai/api/v1
#   https://gateway.ai.cloudflare.com/v1/<ACCOUNT>/<GATEWAY>  (Cloudflare AI Gateway)
[vars]
OPENAI_BASE_URL = "https://openrouter.ai/api/v1"
MODEL_NAME = "google/gemma-4-26b-a4b-it:free"
# Optional: cheap/fast text-only model for messages WITHOUT media (the common
# spam/link case). MODEL_NAME (multimodal) is used for images/text-vs-image
# automatically. When unset, MODEL_NAME is used for everything.
# TEXT_MODEL = "workers-ai/@cf/zai-org/glm-4.7-flash"
# Optional LLM tuning. All omitted here -> code defaults (see README).
# LLM_TIMEOUT_MS = "60000"          # LLM request timeout, ms
# LLM_MAX_TOKENS = "2048"           # cap on LLM output tokens
# LLM_RESPONSE_FORMAT = "json"      # strict JSON output, model-dependent
#
# Generic provider/model escape hatch: arbitrary JSON merged into the LLM
# request body. Set the correct thinking-toggle param for YOUR model here:
#   GLM or Gemma on CF Workers AI -> {"chat_template_kwargs":{"enable_thinking":false}}
#   Qwen3     -> {"enable_thinking":false}
#   OpenAI    -> {"reasoning_effort":"none"}
#
# Verified 2026-08-11 on CF Workers AI: glm-4.7-flash AND gemma-4-26b-a4b-it
# ignore {"thinking":{"type":"disabled"}} but honor
# chat_template_kwargs.enable_thinking:false. With thinking ON and a tight
# max_tokens cap, reasoning can consume the whole budget -> empty content ->
# unparseable (fail-open). Disabling thinking is ~4x faster / ~7x fewer tokens.
#
# LLM_EXTRA_BODY_JSON applies to the IMAGE model (MODEL_NAME); TEXT_EXTRA_BODY_JSON
# applies to the TEXT model. When TEXT_EXTRA_BODY_JSON is unset it falls back to
# LLM_EXTRA_BODY_JSON, so both are covered with one value.
# LLM_EXTRA_BODY_JSON = "{\"chat_template_kwargs\":{\"enable_thinking\":false}}"

# Time-based activation (night hours). IANA timezone.
TIMEZONE = "Asia/Baghdad"
START_HOUR = 21
END_HOUR = 6

# Which messages to send to the LLM. One of:
#   all          - every message
#   media        - only messages with photos/videos/animations/documents
#   links        - only messages containing links
#   media-links  - only messages with media OR links (recommended; saves tokens)
PROCESS_MODE = "media-links"

# Optional comma-separated admin usernames (with or without leading @) and/or
# admin numeric user IDs. When either is set, admin detection is a fast local
# match and the getChatMember API call is skipped per message. When neither is
# set, the API call is used instead.
# Examples:
#   ADMIN_USERNAMES = "alice, BobManager, @carol"
#   ADMIN_USER_IDS = "123456789, 987654321"
# ADMIN_USERNAMES = ""
# ADMIN_USER_IDS = ""

# Optional chat whitelist: comma-separated numeric chat IDs the bot is allowed
# to moderate. Supergroup IDs are negative (e.g. -1001234567890). When set, any
# message from another chat is ignored before any LLM/media/admin work. Unset or
# empty = allow all groups (backward compatible / fail-open).
# ALLOWED_GROUP_IDS = "-1001234567890, -1009876543210"

# Admin panel (audit-log viewer). ADMIN_PANEL_TOKEN (a secret, in .dev.vars /
# `wrangler secret put`) enables the panel; ADMIN_PANEL_PATH sets the URL
# prefix (default /admin). The panel is disabled entirely unless the token is
# set. Login uses a token form -> HMAC-signed HttpOnly cookie (12h TTL).
ADMIN_PANEL_PATH = "/admin"

# Optional funny reply after a flagged message is deleted. Set to "true" to
# enable, and choose the language for the reply.
# NOTE: the master switches (ENABLE_MODERATION / ENABLE_FUNRESPONSE /
# ENABLE_SELF_CLEAN) can be flipped at runtime from the admin panel's Settings
# tab — the D1 `settings` table (migration 0007) shadows each env var, and
# deleting a row reverts to the value configured here.
ENABLE_FUNRESPONSE = "true"
FUNRESPONSE_LANGUAGE = "Arabic"   # or "Spanish", "French", "German"...
# Optional dialect of the language above, e.g. "Egyptian", "Gulf",
# "Levantine" for Arabic. Omitted -> no dialect hint is sent.
FUNRESPONSE_DIALECT = "Gulf"      # or "Egyptian", "Levantine", "Standard"...

# Self-clean: auto-delete the bot's own messages (e.g. fun replies) after a
# TTL. When enabled, every outgoing bot message is tracked in the bot_messages
# table (migration 0006) and deleted via Telegram once it is older than
# SELF_CLEAN_TTL_MINUTES; the */10 cron trigger below does the work. Rows
# that can never be deleted (already gone, older than Telegram's ~48h cap,
# or 5 failed attempts) are dropped with a debug-level audit event.
ENABLE_SELF_CLEAN = "false"
SELF_CLEAN_TTL_MINUTES = "60"

# Optional custom moderation system prompt. Omitted here -> a strict default
# is used in code (see src/llm-client.ts).
# MODERATION_PROMPT = "your custom prompt..."

# Optional Telegram webhook secret token to validate request origin.
# Set WEBHOOK_SECRET_TOKEN as a secret; if provided, the worker validates it.

# ---------------------------------------------------------------------------
# Audit logging (D1).
#
# The bot writes structured audit rows (decisions + LLM responses) to a D1
# database. Create the database and bind it here, then apply the migration:
#
#   npx wrangler d1 create audit_log
#   npx wrangler d1 migrations apply audit_log
#
# LOG_LEVEL: minimum level to persist (debug|info|warn|error). Default info.
# LOG_RETENTION_DAYS: delete rows older than N days (default 30). The cron
#   trigger below prunes retired rows on a schedule; rows are also pruned
#   opportunistically on each write.
# LOG_ENABLED: master switch. 'false' disables all D1 audit writes entirely
#   (default is enabled). Handy to cut D1 writes/cost in production.
LOG_LEVEL = "debug"
LOG_RETENTION_DAYS = "30"
LOG_ENABLED = "true"

# ---------------------------------------------------------------------------
# News digest (FEATURE_PLAN.md). Cron gate "0 * * * *" in [triggers] below;
# src/features/digest/pipeline.ts resolves the content type per gate tick.
# ---------------------------------------------------------------------------
ENABLE_NEWS_DIGEST = "true"
NEWS_DOMAIN = "tech"                # tech | finance | science | health | custom
                                    # (`tech` spans western + Chinese sources)
# Rotation (one preset per daily slot, recorded in the post's domain):
#   round-robin (alias: all) — cycle tech -> finance -> science -> health
#   random — deterministic slot-keyed pick (retry-safe)
# NEWS_DOMAIN = "round-robin"
NEWS_MODE = "both"                  # news | papers | both
NEWS_TARGET_CHAT_ID = "-100XXXXXXXXXX"  # channel/group id; bot must be an admin there
NEWS_LANGUAGE = "Arabic"
NEWS_DIALECT = "Standard"           # optional dialect hint
NEWS_AUTO_PUBLISH = "true"          # false = store drafts for review in the Digest tab
ENABLE_POST_ANALYTICS = "true"      # needs --reactions on set-webhook (allowed_updates)
NEWS_MAX_ITEMS = "5"
NEWS_MIN_POINTS = "25"              # HN quality threshold
NEWS_FETCH_FULLTEXT = "false"       # enrich top items with extracted page text
NEWS_EXTRACT_MAX_PER_RUN = "4"      # cost guard: max extractions per run
# Intraday schedule (plan §23.6): CSV of `hour:tag` slots that drive the hourly
# gate. Each slot pins its own engines + LLM mode + token budget and tags its
# slot key, so a single day can run several digests. Hours are local (TIMEZONE).
# This is the SINGLE source of digest timing — unset means the digest does not
# run (the gate logs a daily warning). Weekly/monthly rollups fire at the
# earliest scheduled hour. Each `tag`:
#   headlines -> gnews(+en & zh locales) + hn + rss + tavily/exa/jsearch (if keys set)
#   papers    -> arxiv + hf + s2
#   trending  -> hn (topic-agnostic match-all)
#   deep      -> D1 deep-dive over today's published items (no fetching; richer
#                prompt + 5000-token budget; schedule it AFTER headlines)
# NEWS_SCHEDULE = "9:headlines,14:papers,20:trending,22:deep"
# Digest LLM profile (DIGEST_MODEL -> TEXT_MODEL -> MODEL_NAME fallback).
# Recommended for multilingual output (esp. Arabic): the multimodal gemma
# model — set it explicitly so the digest does not inherit the text-only
# glm model:
# DIGEST_MODEL = "workers-ai/@cf/google/gemma-4-26b-a4b-it"
# DIGEST_BASE_URL / DIGEST_API_KEY -> run the digest on its own LLM provider
#   (falls back to OPENAI_BASE_URL / OPENAI_API_KEY). DIGEST_MODEL /
#   DIGEST_RESPONSE_FORMAT / DIGEST_TIMEOUT_MS likewise. DIGEST_EXTRA_BODY_JSON
#   does NOT fall back to the moderation one: provider payloads are not
#   portable (Workers AI `chat_template_kwargs` is a 400 on google-ai-studio).
#   Leave it unset unless the digest provider needs its own body tweaks.
# NEWS_ENGINE = "gnews"             # news: gnews | hn | rss | tavily | exa | jsearch; scholar: arxiv | hf | s2 (default: preset chain)
# Secrets (set via `wrangler secret put`, never committed):
#   JINA_API_KEY        — Reader extraction fallback (500 RPM keyed, JSON mode)
#                         AND the `jsearch` engine (s.jina.ai). WARNING: each
#                         search request costs a FIXED ~10,000 tokens against
#                         the shared 10M-token free pool (~1,000 searches total).
#   LLAMAINDEX_APIKEY   — LlamaParse documents/PDF extraction (10K credits free,
#                         Fast tier 1 credit/page). Only used for .pdf URLs.
# NEWS_RSS_FEEDS = "https://www.qbitai.com/feed"
# NEWS_TOPICS = "artificial intelligence, developer tools"
# NEWS_ARXIV_CATEGORIES = "cs.AI,cs.CL"
# NEWS_INCLUDE_DOMAINS = "arstechnica.com, theverge.com"
# NEWS_DRAFT_NOTIFY_CHAT_ID = "-100XXXXXXXXXX"  # unset -> DM every ADMIN_USER_IDS
# NEWS_DRAFT_TTL_DAYS = "7"
# NEWS_ENABLE_WEEKLY = "true"       # weekly roundup (NEWS_WEEKLY_DAY, default Sunday)
# NEWS_ENABLE_MONTHLY = "true"      # monthly deep dive (NEWS_MONTHLY_DAY, default 1)
# NEWS_SPONSOR_TEXT = "Brought to you by ..."   # appended post-sanitize, never LLM-generated
# Dev-only: 'true' enables POST /api/digest/dev/seed — runs the REAL pipeline
# (engines → extraction → LLM → draft row) from a chosen local hour + slot tag,
# so a test draft mirrors exactly what a cron tick at that slot would post.
# Result lands in Pending drafts for review/edit/publish/discard.
# Consumes real API quota — NEVER enable in production (endpoint 404s there).
# NEWS_DEV_SEED = "true"

[[d1_databases]]
binding = "DB"
database_id = "<D1-Database-ID>"
database_name = "telegram-mod-bot-db"
migrations_dir = "migrations"

# Cron triggers (expressions are always UTC). MUST stay in sync with
# CRON_BOT_CLEANUP in src/index.ts:
#   */10 * * * *  self-clean expired bot messages (ENABLE_SELF_CLEAN).
#                 For high-traffic groups use "*/5 * * * *" (and update the
#                 constant in src/index.ts to match).
#   0 4 * * *     daily prune of expired audit rows (LOG_RETENTION_DAYS).
#                 04:00 UTC = 07:00 Asia/Baghdad (UTC+3) in winter; the
#                 prune itself is timezone-agnostic.
[triggers]
#   0 * * * *     news digest gate (ENABLE_NEWS_DIGEST): resolves the content
#                 type (daily/weekly/monthly) and publishes or stores a draft.
crons = ["*/10 * * * *", "0 * * * *", "0 4 * * *"]

# ---------------------------------------------------------------------------
# Module rules: admin panel static assets.
#
# The admin panel is split into src/templates/admin.html (markup),
# src/templates/css/style.css and src/templates/js/app.js (client logic).
# All three are imported into the worker as Text (plain strings) and served
# back verbatim behind the admin cookie — what's in the repo is byte-for-byte
# what the browser gets.
#
# Why these rules are needed:
#  - .html is already Text by Wrangler's defaults (no rule needed).
#  - .css has NO default rule, so without one the import fails.
#  - .js is treated as an ES module by default ("No matching export for
#    default"); the rule below overrides that for the templates folder only.
#
# Wrangler-4 gotchas baked in here:
#  - the field is `globs` (older docs show `include`).
#  - `fallthrough = true` is REQUIRED: a rule without it silently disables
#    all later rules of the same type, which would break the built-in
#    .html -> Text default and fail the build.
# ---------------------------------------------------------------------------
[[rules]]
type = "Text"
globs = ["**/templates/css/*.css"]
fallthrough = true

[[rules]]
type = "Text"
globs = ["**/templates/js/*.js"]
fallthrough = true
