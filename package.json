{
  "name": "telegram-mod-bot",
  "version": "1.1.0",
  "private": true,
  "description": "Serverless Telegram moderation bot on Cloudflare Workers with a configurable OpenAI-compatible multimodal LLM",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "set-webhook": "node scripts/set-webhook.mjs",
    "rotate-token": "node scripts/rotate-token.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.4.5",
    "vite": "^7.0.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.120.0"
  }
}
